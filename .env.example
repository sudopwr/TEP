# Copy to .env and adjust. .env is gitignored; this file is not.
#
# Everything here has a working default. A fresh checkout needs no .env at
# all — the server creates one on first run with a generated SESSION_SECRET.

# Signs the session cookie (CLAUDE.md section 5a).
#
# Generated automatically on first run if absent, so leave this alone unless
# you have a reason. It signs the cookie; it does not encrypt it, and it is
# not the session id. Changing it signs everyone out and reveals nothing.
#
# To rotate by hand:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Where the database lives. Back up by copying data/ (N6).
PAYOUT_DB=data/app.db

# The server refuses to bind anywhere but loopback while the shipped
# admin / admin password is still in place, and says why (N10, section 5a).
HOST=127.0.0.1
PORT=3000

# Reads the two ends of a transfer off an explorer link or a bare hash (F29).
#
# The only outbound request this application makes, and only when somebody
# pastes a link and asks. Leave it empty and the lookup is simply off: the
# wallet fields stay typeable and the interface says why.
#
# One free key from etherscan.io covers Ethereum, BSC and Polygon (their V2
# API takes the chain as a number). Tronscan needs no key.
ETHERSCAN_API_KEY=

# Where those two APIs live. Only a test points these anywhere else.
# PAYOUT_ETHERSCAN_API=https://api.etherscan.io/v2/api
# PAYOUT_TRONSCAN_API=https://apilist.tronscanapi.com/api
