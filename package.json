{
  "name": "payout-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "npm run dev --workspace @payout/web",
    "build": "npm run lint && tsc -b tsconfig.json && vite build apps/web",
    "start": "tsx apps/api/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.tests.web.json && tsc -p tsconfig.e2e.json",
    "import": "tsx apps/api/src/cli/import.ts",
    "backup": "tsx apps/api/src/cli/backup.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.3",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
